# Copy to .env.local and fill in LC_MERCHANT_API_KEY with a real sandbox_api_key
# (see alvin_iyap360_micro's user_merchants.sandbox_api_key, or reuse the value
# already in liquidcash-pay-sdk/examples/plain-php/.env from Phase 4 testing).

# --- Server-side only: merchant API (session creation / authoritative status) ---
# This is the SAME merchant API liquidcash-pay-sdk (PHP) calls. Never exposed to the browser.
LC_MERCHANT_API_KEY=
LC_MERCHANT_API_BASE=http://127.0.0.1:8000/api/merchant
# "sandbox" | "production" -- this is the MERCHANT API's environment axis.
LC_MERCHANT_ENVIRONMENT=sandbox

# This shop's own base URL, used to build success_url/cancel_url passed to createSession().
LC_MERCHANT_ORIGIN=http://localhost:3000

# --- Browser-side: the liquidcash-pay.js SDK ---
# Where the pay-app dev server is currently serving the SDK bundle.
NEXT_PUBLIC_LC_SDK_URL=http://localhost:5173/liquidcash-pay.js
# "local" | "sandbox" | "production" -- this is the SDK's OWN environment axis
# (which pay-app host it redirects the browser to -- see sdk/pay-app-urls.json).
# It is NOT the same value as LC_MERCHANT_ENVIRONMENT above. For local testing
# against a locally-running pay-app dev server, this MUST be "local".
NEXT_PUBLIC_LC_SDK_ENVIRONMENT=local
